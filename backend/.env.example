# Banco — SQLite no dev (default), Postgres em produção/Docker
# Postgres: postgresql+psycopg2://carprice:carprice@db:5432/carprice
DATABASE_URL=sqlite:///./carprice.db

# Agendador
SCRAPE_DEFAULT_INTERVAL_MIN=60
SCHEDULER_ENABLED=true

# E-mail (SMTP) — notificações
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@carprice.local
SMTP_USE_TLS=true

# FIPE: usa a API interna OFICIAL (veiculos.fipe.org.br) — sem configuração necessária.

# Coleta
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
HTTP_TIMEOUT_S=30

# CORS (frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
